datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  JAZZCASH
  EASYPAISA
  SAFEPAY
  PAYFAST
  CASH_AT_CLINIC
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Doctor {
  id            String         @id @default(uuid())
  name          String
  specialty     String
  qualification String
  experience    Int
  fee           Float
  contact       String
  photo         String         @db.Text
  room          String
  rating        Float          @default(5.0)
  reviewCount   Int            @default(0)
  workingDays   String         // Comma separated: "Mon,Wed,Fri"
  shiftStart    String         // e.g. "17:00"
  shiftEnd      String         // e.g. "21:00"
  slotDuration  Int            @default(20) // in minutes
  isActive      Boolean        @default(true)
  bio           String         @db.Text
  appointments  Appointment[]
  leaves        LeaveDate[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model LeaveDate {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  reason    String
  createdAt DateTime @default(now())

  @@unique([doctorId, date])
  @@index([date])
}

model Appointment {
  id              String               @id // e.g. "APT-10021"
  tokenNumber     Int
  doctorId        String
  doctor          Doctor               @relation(fields: [doctorId], references: [id])
  patientName     String
  patientPhone    String
  age             Int
  gender          Gender               @default(MALE)
  notes           String?              @db.Text
  date            String               // "YYYY-MM-DD"
  timeSlot        String               // "05:15 PM"
  consultationFee Float
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus        @default(PENDING)
  isWalkIn        Boolean              @default(false)
  transactions    PaymentTransaction[]
  createdAt       DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([doctorId, date, timeSlot])
  @@unique([doctorId, date, tokenNumber])
  @@index([date, isWalkIn])
}

model PaymentTransaction {
  id               String        @id @default(uuid())
  appointmentId    String
  appointment      Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  gateway          String        // "SAFEPAY" | "PAYFAST" | "CASH"
  amount           Float
  currency         String        @default("PKR")
  status           PaymentStatus @default(PENDING)
  gatewayReference String?       // Tracker ID or PayFast transaction ID
  signature        String?       // Verification signature / hash
  metadata         String?       @db.Text // JSON string
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}
